{% extends 'admin/base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}Constructeur de catalogue{% endblock %}

{% block body %}
<div data-controller="catalog-admin"
     data-catalog-admin-worker-url-value="{{ asset('vendor/pdfjs-dist/build/pdf.worker.min.mjs.js') }}"
     data-catalog-admin-reorder-url-value="{{ path('admin_catalog_reorder') }}"
     data-catalog-admin-reorder-token-value="{{ csrf_token('catalog_reorder') }}"
     data-catalog-admin-contents-reorder-url-value="{{ path('admin_catalog_contents_reorder') }}"
     data-catalog-admin-contents-reorder-token-value="{{ csrf_token('catalog_contents_reorder') }}">
    <header class="admin-page-heading admin-catalog-heading">
        <div><span class="admin-kicker">Module commercial</span><h1>Constructeur de catalogue</h1><p>Importez vos PDF ou images, organisez les pages et configurez leurs redirections.</p></div>
        <div class="admin-heading-actions">
            <a class="admin-button admin-button-light" href="{{ path('admin_catalog_preview') }}" target="_blank" rel="noopener">Aperçu {{ ui.icon('eye') }}</a>
        </div>
    </header>

    <section class="admin-panel admin-catalog-settings">
        <form action="{{ path('admin_catalog_settings') }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('catalog_settings') }}">
            <div><span class="admin-catalog-status-dot {{ catalog.enabled ? 'is-online' : '' }}"></span><span><strong>{{ catalog.enabled ? 'Catalogue publié' : 'Catalogue désactivé' }}</strong><small>{{ catalog.enabled ? 'Le bouton est visible sur la page Expertise.' : 'Le catalogue est masqué du site public.' }}</small></span></div>
            <label><span>Titre du catalogue</span><input type="text" name="title" maxlength="180" required value="{{ catalog.title }}"></label>
            <label class="admin-catalog-toggle"><input type="checkbox" name="enabled" value="1"{% if catalog.enabled %} checked{% endif %}><span><strong>Activer sur le site</strong><small>Affiche le bouton Catalogue dans Expertise</small></span><i><b></b></i></label>
            <button class="admin-button admin-button-primary" type="submit">Enregistrer {{ ui.icon('check') }}</button>
        </form>
    </section>

    <section class="admin-panel admin-catalog-contents" id="sommaire">
        <header>
            <span class="admin-catalog-import-icon">{{ ui.icon('book') }}</span>
            <div><span class="admin-kicker">Pages automatiques</span><h2>{{ catalog.contentsTitle }}</h2><p>Faites glisser les documents pour personnaliser leur ordre.</p></div>
            <span class="admin-catalog-contents-count">{{ contentsEntries|length }} document{{ contentsEntries|length > 1 ? 's' : '' }} · {{ contentsPages|length }} page{{ contentsPages|length > 1 ? 's' : '' }}</span>
        </header>
        <form action="{{ path('admin_catalog_contents') }}" method="post">
            <input type="hidden" name="_token" value="{{ csrf_token('catalog_contents') }}">
            <label class="admin-catalog-contents-title"><span>Titre de la page</span><input type="text" name="contentsTitle" maxlength="100" required value="{{ catalog.contentsTitle }}"></label>
            {% if contentsEntries %}
                <div class="admin-catalog-contents-list" data-catalog-admin-target="contentsList">
                    {% for entry in contentsEntries %}
                        <div data-catalog-admin-target="contentsEntry" data-contents-key="{{ entry.key }}" data-action="dragover->catalog-admin#overContents drop->catalog-admin#dropContents">
                            <button type="button" draggable="true" data-action="dragstart->catalog-admin#startContentsDrag dragend->catalog-admin#finishContentsDrag" aria-label="Déplacer {{ entry.label }}" title="Glisser pour déplacer"><span aria-hidden="true">⠿</span></button>
                            <i>{{ '%02d'|format(loop.index) }}</i>
                            <label><input type="text" name="contentsLabels[{{ entry.key }}]" maxlength="180" value="{{ entry.label }}"><small>{{ entry.filename }} · page {{ entry.pageNumber }}{% if entry.pageCount > 1 %} · {{ entry.pageCount }} pages PDF{% endif %}</small></label>
                        </div>
                    {% endfor %}
                </div>
                <footer>
                    <p data-catalog-admin-target="contentsStatus">Le nouvel ordre est enregistré automatiquement. Un champ vide reprend le nom du PDF.</p>
                    <div><button class="admin-button admin-button-light" type="submit" name="resetOrder" value="1">Rétablir l’ordre automatique</button><button class="admin-button admin-button-light" type="submit" name="resetLabels" value="1">Rétablir les noms</button><button class="admin-button admin-button-primary" type="submit">Enregistrer {{ ui.icon('check') }}</button></div>
                </footer>
            {% else %}
                <div class="admin-catalog-contents-empty"><strong>Aucun PDF dans le catalogue</strong><p>La page de sommaire apparaîtra automatiquement après le premier import PDF.</p></div>
            {% endif %}
        </form>
    </section>

    <div class="admin-catalog-import-grid">
        <section class="admin-panel admin-catalog-import">
            <header><span class="admin-catalog-import-icon">{{ ui.icon('book') }}</span><div><span class="admin-kicker">Import principal</span><h2>Importer des PDF</h2><p>Chaque document peut contenir une ou plusieurs pages.</p></div></header>
            <form action="{{ path('admin_catalog_import_pdf') }}" method="post" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('catalog_import_pdf') }}">
                <input type="hidden" name="pdfPageCounts" data-catalog-admin-target="pdfPageCounts">
                <input type="hidden" name="pdfFileCount" data-catalog-admin-target="pdfFileCount">
                <label><span>Nom du document <small>optionnel · utilisé pour un PDF unique</small></span><input type="text" name="pdfTitle" maxlength="150" placeholder="Catalogue formations 2027"></label>
                <label class="admin-catalog-file"><input type="file" name="pdfs[]" accept=".pdf,application/pdf" multiple required data-catalog-admin-target="pdfInput" data-action="change->catalog-admin#inspectPdf"><span>{{ ui.icon('book') }}</span><strong>Choisir un ou plusieurs PDF</strong><small>50 fichiers · 90 Mo et 200 pages maximum par PDF</small></label>
                <div class="admin-catalog-pdf-selection" data-catalog-admin-target="pdfSelection" hidden></div>
                <p class="admin-catalog-file-status" data-catalog-admin-target="pdfStatus">Les documents seront analysés avant l’import.</p>
                <button class="admin-button admin-button-primary" type="submit" data-catalog-admin-target="pdfSubmit">Importer les PDF {{ ui.icon('arrow') }}</button>
            </form>
        </section>

        <section class="admin-panel admin-catalog-import">
            <header><span class="admin-catalog-import-icon admin-catalog-import-icon-image">{{ ui.icon('image') }}</span><div><span class="admin-kicker">Pages visuelles</span><h2>Ajouter des images</h2><p>Ajoutez plusieurs pages JPG, PNG ou WebP en une seule fois.</p></div></header>
            <form action="{{ path('admin_catalog_add_images') }}" method="post" enctype="multipart/form-data">
                <input type="hidden" name="_token" value="{{ csrf_token('catalog_add_images') }}">
                <label class="admin-catalog-file"><input type="file" name="images[]" accept="image/jpeg,image/png,image/webp" multiple required><span>{{ ui.icon('image') }}</span><strong>Choisir des images</strong><small>15 Mo maximum par image · 50 images</small></label>
                <p class="admin-catalog-file-status">Les images sont optimisées en WebP haute définition.</p>
                <button class="admin-button admin-button-primary" type="submit">Ajouter les pages {{ ui.icon('arrow') }}</button>
            </form>
        </section>
    </div>

    <section class="admin-catalog-pages" id="pages">
        <header><div><span class="admin-kicker">Composition</span><h2>{{ catalogPages|length }} page{{ catalogPages|length > 1 ? 's' : '' }}{% if contentsEntries %} + sommaire{% endif %}</h2><p>Modifiez les pages ou faites-les glisser pour changer leur ordre.</p></div><span data-catalog-admin-target="reorderStatus">Mis à jour le {{ catalog.updatedAt|date('d/m/Y à H:i') }}</span></header>
        <div class="admin-catalog-page-grid" data-catalog-admin-target="pageGrid">
            {% for catalogPage in catalogPages %}
                <article class="admin-panel admin-catalog-page{{ catalogPage.enabled ? '' : ' is-disabled' }}" id="page-{{ catalogPage.id }}" data-catalog-admin-target="pageCard" data-page-id="{{ catalogPage.id }}" data-action="dragover->catalog-admin#overPage drop->catalog-admin#dropPage">
                    <div class="admin-catalog-page-preview">
                        {% if catalogPage.imagePath %}<img src="{{ asset(catalogPage.imagePath) }}" alt="">
                        {% else %}<canvas data-catalog-admin-target="pdfPreview" data-pdf-source="{{ asset(catalogPage.pdfPath) }}" data-pdf-page="{{ catalogPage.pdfPage|default(1) }}" aria-label="Aperçu de {{ catalogPage.title }}"></canvas>{% endif %}
                        <i>{{ '%02d'|format(catalogPage.position) }}</i>
                        {% if not catalogPage.enabled %}<b>Masquée</b>{% endif %}
                    </div>
                    <form class="admin-catalog-page-form" action="{{ path('admin_catalog_page_update', {id: catalogPage.id}) }}" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="_token" value="{{ csrf_token('catalog_page_' ~ catalogPage.id) }}">
                        <label><span>Titre</span><input type="text" name="title" maxlength="180" required value="{{ catalogPage.title }}"></label>
                        <label><span>Redirection de la page</span><input type="text" inputmode="url" name="linkUrl" maxlength="2048" value="{{ catalogPage.linkUrl }}" placeholder="https://… ou /contact"></label>
                        <div class="admin-catalog-page-toggles">
                            <label><input type="checkbox" name="enabled" value="1"{% if catalogPage.enabled %} checked{% endif %}> Page visible</label>
                            <label><input type="checkbox" name="openInNewTab" value="1"{% if catalogPage.opensLinkInNewTab %} checked{% endif %}> Nouvel onglet</label>
                        </div>
                        <label class="admin-catalog-replace"><span>Remplacer le média</span><input type="file" name="media" accept="image/jpeg,image/png,image/webp,.pdf,application/pdf"><small>Image ou PDF · facultatif</small></label>
                        <button class="admin-button admin-button-primary" type="submit">Enregistrer</button>
                    </form>
                    <footer>
                        <div>
                            <button class="admin-catalog-drag-handle" type="button" draggable="true" data-action="dragstart->catalog-admin#startPageDrag dragend->catalog-admin#finishPageDrag" aria-label="Déplacer la page par glisser-déposer" title="Glisser pour déplacer"><span aria-hidden="true">⠿</span> Glisser</button>
                            <form action="{{ path('admin_catalog_page_move', {id: catalogPage.id, direction: 'up'}) }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('catalog_move_' ~ catalogPage.id) }}"><button type="submit" aria-label="Monter la page" title="Monter"{% if loop.first %} disabled{% endif %}>↑</button></form>
                            <form action="{{ path('admin_catalog_page_move', {id: catalogPage.id, direction: 'down'}) }}" method="post"><input type="hidden" name="_token" value="{{ csrf_token('catalog_move_' ~ catalogPage.id) }}"><button type="submit" aria-label="Descendre la page" title="Descendre"{% if loop.last %} disabled{% endif %}>↓</button></form>
                        </div>
                        <form action="{{ path('admin_catalog_page_delete', {id: catalogPage.id}) }}" method="post" data-action="submit->admin-shell#confirm" data-admin-shell-message-param="Supprimer définitivement cette page du catalogue ?"><input type="hidden" name="_token" value="{{ csrf_token('catalog_delete_' ~ catalogPage.id) }}"><button class="admin-catalog-delete" type="submit">Supprimer</button></form>
                    </footer>
                </article>
            {% else %}
                <div class="admin-panel admin-catalog-empty"><span>{{ ui.icon('book') }}</span><h2>Le catalogue est vide</h2><p>Importez un PDF ou ajoutez des images pour créer ses premières pages.</p></div>
            {% endfor %}
        </div>
    </section>
</div>
{% endblock %}
