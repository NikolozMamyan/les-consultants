{% extends 'admin/base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}Constructeur de contenu{% endblock %}

{% block body %}
<header class="admin-page-heading">
    <div>
        <span class="admin-kicker">Constructeur de thème</span>
        <h1>Contenus du site</h1>
        <p>Modifiez les composants globaux, les textes et les visuels depuis un seul espace.</p>
    </div>
    <div class="admin-heading-actions"><span class="admin-content-health"><i></i> Toutes les pages sont publiées</span></div>
</header>

<section class="admin-panel admin-components-panel">
    <header class="admin-panel-header admin-table-heading">
        <div><span class="admin-global-label">Structure globale</span><h2>Menu & pied de page</h2><p>Ces contenus sont partagés automatiquement sur tout le site.</p></div>
        <span class="admin-global-scope">{{ ui.icon('activity') }} Toutes les pages</span>
    </header>
    <div class="admin-table-wrap">
        <table class="admin-table admin-components-table">
            <thead><tr><th>Composant</th><th>Zones</th><th>Portée</th><th>Dernière modification</th><th>Actions</th></tr></thead>
            <tbody>
            {% for component in components %}
                <tr>
                    <td><span class="admin-page-cell admin-component-cell"><i>{{ ui.icon(component.icon) }}</i><span><strong>{{ component.name }}</strong><small>{{ component.description }}</small></span></span></td>
                    <td><strong>{{ component.sectionsCount }}</strong> zones</td>
                    <td><span class="admin-global-status"><i></i> Site entier</span></td>
                    <td>{{ component.updated }}</td>
                    <td>
                        <span class="admin-row-actions">
                            <a class="admin-action-secondary" href="{{ path(component.route) }}" target="_blank" rel="noopener">{{ ui.icon('eye') }} Aperçu</a>
                            <a class="admin-action-primary" href="{{ path('admin_content_edit', {slug: component.slug}) }}">{{ ui.icon('edit') }} Modifier</a>
                        </span>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>

<section class="admin-panel admin-pages-panel">
    <header class="admin-panel-header admin-table-heading">
        <div><h2>Pages principales</h2><p>{{ pages|length }} pages disponibles</p></div>
        <label class="admin-search">{{ ui.icon('search') }}<input type="search" placeholder="Rechercher une page" aria-label="Rechercher une page"></label>
    </header>
    <div class="admin-table-wrap">
        <table class="admin-table admin-pages-table">
            <thead><tr><th>Page</th><th>Sections</th><th>Dernière modification</th><th>Statut</th><th>Actions</th></tr></thead>
            <tbody>
            {% for pageItem in pages %}
                <tr>
                    <td><span class="admin-page-cell"><i>{{ ui.icon(pageItem.icon) }}</i><span><strong>{{ pageItem.name }}</strong><small>{{ pageItem.description }}</small></span></span></td>
                    <td><strong>{{ pageItem.sectionsCount }}</strong> sections</td>
                    <td>{{ pageItem.updated }}</td>
                    <td><span class="admin-published"><i></i> Publiée</span></td>
                    <td>
                        <span class="admin-row-actions">
                            <a class="admin-action-secondary" href="{{ path(pageItem.route) }}" target="_blank" rel="noopener">{{ ui.icon('eye') }} Voir</a>
                            <a class="admin-action-primary" href="{{ path('admin_content_edit', {slug: pageItem.slug}) }}">{{ ui.icon('edit') }} Modifier</a>
                        </span>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>

<aside class="admin-info-banner">
    <span>{{ ui.icon('check') }}</span>
    <div><strong>Un éditeur centralisé et sécurisé</strong><p>Les administrateurs gardent la main sur tous les contenus visibles sans toucher à la structure ni au code du site.</p></div>
</aside>
{% endblock %}
