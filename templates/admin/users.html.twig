{% extends 'admin/base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}Utilisateurs{% endblock %}

{% block body %}
<header class="admin-page-heading">
    <div><span class="admin-kicker">Accès & sécurité</span><h1>Utilisateurs</h1><p>Gérez les personnes autorisées à accéder au back-office.</p></div>
    <button class="admin-button admin-button-primary" type="button" data-action="admin-shell#demo" data-admin-shell-message-param="La création de comptes sera activée avec l’authentification.">Inviter un utilisateur {{ ui.icon('people') }}</button>
</header>

<aside class="admin-security-banner"><span>{{ ui.icon('check') }}</span><div><strong>Les rôles seront appliqués à la prochaine étape</strong><p>Super administrateur, administrateur et éditeur de contenu pourront disposer de droits distincts.</p></div></aside>

<section class="admin-panel">
    <header class="admin-panel-header admin-table-heading"><div><h2>Équipe</h2><p>{{ users|length }} utilisateurs dans la maquette</p></div><label class="admin-search">{{ ui.icon('search') }}<input type="search" placeholder="Rechercher un utilisateur" aria-label="Rechercher un utilisateur"></label></header>
    <div class="admin-table-wrap">
        <table class="admin-table admin-users-table">
            <thead><tr><th>Utilisateur</th><th>Rôle</th><th>Statut</th><th>Dernière activité</th><th></th></tr></thead>
            <tbody>{% for user in users %}<tr><td><span class="admin-user-cell"><i>{{ user.initials }}</i><span><strong>{{ user.name }}</strong><small>{{ user.email }}</small></span></span></td><td><span class="admin-role">{{ user.role }}</span></td><td><span class="admin-published"><i></i> {{ user.status }}</span></td><td>{% if user.lastSeen == 'En ligne' %}<span class="admin-online"><i></i> En ligne</span>{% else %}{{ user.lastSeen }}{% endif %}</td><td><button class="admin-row-menu" type="button" aria-label="Actions pour {{ user.name }}" data-action="admin-shell#demo" data-admin-shell-message-param="La gestion des permissions sera activée avec l’authentification.">•••</button></td></tr>{% endfor %}</tbody>
        </table>
    </div>
</section>
{% endblock %}
