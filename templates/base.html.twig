<!doctype html>
<html lang="fr">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="{% block meta_description %}Les Consultants accompagne les acteurs de la finance au Luxembourg avec des consultants externes spécialisés et des formations dédiées aux métiers régulés.{% endblock %}">
        <meta name="theme-color" content="#0b8485">
        <title>{% block title %}Les Consultants{% endblock %}</title>
        <link rel="canonical" href="{% block canonical_url %}{{ app.request.schemeAndHttpHost ~ app.request.baseUrl ~ app.request.pathInfo }}{% endblock %}">
        <meta property="og:locale" content="fr_FR">
        <meta property="og:site_name" content="Les Consultants">
        <meta property="og:type" content="{% block og_type %}website{% endblock %}">
        <meta property="og:title" content="{% block og_title %}{{ block('title') }}{% endblock %}">
        <meta property="og:description" content="{% block og_description %}{{ block('meta_description') }}{% endblock %}">
        <meta property="og:url" content="{{ block('canonical_url') }}">
        <meta property="og:image" content="{% block og_image %}{{ absolute_url(asset('images/logo-original.png')) }}{% endblock %}">
        <meta name="twitter:card" content="summary_large_image">
        <link rel="icon" href="{{ asset('images/logo-original.png') }}">
        <link rel="preload" href="{{ asset('fonts/plus-jakarta-sans.woff2') }}" as="font" type="font/woff2" crossorigin>
        <link rel="stylesheet" href="{{ asset('styles/site.css') }}">
        <link rel="stylesheet" href="{{ asset('styles/community-feed.css') }}">
        {% block structured_data %}{% endblock %}
        {% block javascripts %}{{ importmap('app') }}{% endblock %}
    </head>
    <body data-page="{{ page|default('') }}" data-controller="navigation reveal visitor-activity" data-visitor-activity-url-value="{{ path('app_visitor_activity') }}" data-action="keydown.esc@window->navigation#close resize@window->navigation#resize click@window->navigation#outside">
        <a class="skip-link" href="#contenu">Aller au contenu</a>
        {% include 'partials/_page_transition.html.twig' %}
        {% include 'partials/_header.html.twig' %}

        {% for message in app.flashes('success') %}
            <div class="flash-message" role="status">{{ message }}</div>
        {% endfor %}

        {% block body %}{% endblock %}
        {% include 'partials/_footer.html.twig' %}
        {% include 'partials/_mobile_navigation.html.twig' %}
    </body>
</html>
