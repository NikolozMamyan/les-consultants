{% extends 'base.html.twig' %}

{% block title %}{{ post.title }} | Les Consultants Community{% endblock %}
{% block meta_description %}{{ post.excerpt|slice(0, 155) }}{% endblock %}
{% block canonical_url %}{{ url('app_community_post_show', {slug: post.slug}) }}{% endblock %}
{% block og_type %}article{% endblock %}
{% block og_image %}{{ post.mediaType == 'image' and post.mediaUrl ? post.mediaUrl : absolute_url(asset('images/logo-original.png')) }}{% endblock %}
{% block og_image_alt %}{{ post.title }}{% endblock %}

{% block structured_data %}
    <script type="application/ld+json">{{ structuredData|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
{% endblock %}

{% block body %}
<main id="contenu" class="community-publication-page">
    <header class="container frame community-publication-hero">
        <nav class="breadcrumb breadcrumb-on-dark" aria-label="Breadcrumb">
            <a href="{{ path('app_home') }}">Home</a><span aria-hidden="true">/</span>
            <a href="{{ path('app_blog_index') }}">Blog</a><span aria-hidden="true">/</span>
            <span aria-current="page">Community</span>
        </nav>
        <div>
            <span class="eyebrow">Elearning-feed</span>
            <h1>Community post</h1>
            <p>A conversation from the Les Consultants e-learning platform.</p>
        </div>
    </header>

    <div class="container frame community-publication-layout">
        <article class="community-publication-card">
            <header class="community-publication-author">
                {% set usesDefaultAvatar = not post.authorAvatarUrl or post.authorAvatarUrl ends with '/images/User.svg' %}
                <img src="{{ usesDefaultAvatar ? asset('images/User.svg') : post.authorAvatarUrl }}" class="{{ usesDefaultAvatar ? 'community-avatar-default' : '' }}" alt="" loading="lazy">
                <div><strong>{{ post.authorName }}</strong><small>Community member · <time datetime="{{ post.publishedAt|date('c') }}">{{ post.publishedAt|date('d.m.Y') }} at {{ post.publishedAt|date('H:i') }}</time></small></div>
                <span>Les Consultants<br>E-learning</span>
            </header>

            <div class="community-publication-content">{{ post.content|raw }}</div>

            {% if post.mediaUrl %}
                <figure class="community-publication-media">
                    {% if post.mediaType == 'video' %}
                        <video controls playsinline preload="metadata"><source src="{{ post.mediaUrl }}"></video>
                    {% else %}
                        <img src="{{ post.mediaUrl }}" alt="{{ post.title }}">
                    {% endif %}
                </figure>
            {% endif %}

            <div class="community-publication-engagement">
                <span><b>{{ post.likesCount }}</b> reaction{{ post.likesCount != 1 ? 's' }}</span>
                <span><b>{{ post.commentsCount }}</b> comment{{ post.commentsCount != 1 ? 's' }}</span>
            </div>

            <div class="community-publication-actions" aria-label="Interact with this post">
                <a href="{{ post.registrationUrl }}" rel="nofollow"><span aria-hidden="true">♡</span><b>Like</b><small>Create an account to react</small></a>
                <a href="{{ post.registrationUrl }}" rel="nofollow"><span aria-hidden="true">◌</span><b>Comment</b><small>Join the conversation</small></a>
                <a href="{{ post.sourceUrl }}"><span aria-hidden="true">↗</span><b>View on the platform</b><small>Open the e-learning platform</small></a>
            </div>

            {% if post.latestComments %}
                <section class="community-publication-comments" aria-labelledby="community-comments-title">
                    <header><span>Discussion</span><h2 id="community-comments-title">Latest comments</h2></header>
                    {% for comment in post.latestComments %}
                        <article>
                            <span>{{ comment.author|slice(0, 1)|upper }}</span>
                            <div><strong>{{ comment.author }}</strong><p>{{ comment.content }}</p></div>
                            {% if comment.likes %}<small>♡ {{ comment.likes }}</small>{% endif %}
                        </article>
                    {% endfor %}
                    <a href="{{ post.registrationUrl }}" class="community-comments-cta">View the full discussion and reply <span aria-hidden="true">→</span></a>
                </section>
            {% endif %}
        </article>

        <aside class="community-publication-aside">
            <div>
                <span class="community-network-live"><i></i> Join the network</span>
                <h2>Your expertise deserves to be shared.</h2>
                <p>Create your free account to react, comment and publish within the community.</p>
                <a href="{{ post.registrationUrl }}" class="button button-primary">Create my account <span class="arrow-box">↗</span></a>
            </div>
            <a href="{{ path('app_blog_index') }}" class="community-publication-back">← Back to the blog</a>
        </aside>
    </div>
</main>
{% endblock %}
