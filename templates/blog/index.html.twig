{% extends 'base.html.twig' %}

{% block title %}Actualités finance & conformité au Luxembourg | Les Consultants{% endblock %}
{% block meta_description %}Analyses et conseils sur la conformité, la finance, la gestion des risques, la transformation digitale et la formation au Luxembourg.{% endblock %}
{% block canonical_url %}{{ url('app_blog_index') }}{% endblock %}
{% block robots %}{% if search or selectedCategory %}noindex,follow{% else %}index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1{% endif %}{% endblock %}

{% block body %}
<main id="contenu" class="container frame blog-index">
    <section class="blog-hero" data-reveal-target="item">
        <div class="blog-hero-orb blog-hero-orb-one" aria-hidden="true"></div>
        <div class="blog-hero-orb blog-hero-orb-two" aria-hidden="true"></div>
        <nav class="breadcrumb breadcrumb-on-dark" aria-label="Fil d’Ariane">
            <a href="{{ path('app_home') }}">Accueil</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Blog</span>
        </nav>
        <div class="blog-hero-grid">
            <div>
                <div class="eyebrow">Le journal des métiers régulés</div>
                <h1>Décrypter aujourd’hui.<br><span>Décider avec confiance.</span></h1>
            </div>
            <div class="blog-hero-copy">
                <p>Analyses réglementaires, tendances métier et conseils opérationnels pour les acteurs de la finance au Luxembourg.</p>
                <div class="blog-hero-signals" aria-label="Thématiques du blog">
                    <span>Finance</span><span>Compliance</span><span>Risk</span><span>Formation</span>
                </div>
            </div>
        </div>
    </section>

    <section class="blog-discovery" aria-label="Rechercher dans le blog" data-reveal-target="item">
        <form class="blog-search" method="get" action="{{ path('app_blog_index') }}">
            <label for="blog-search-input">Rechercher un sujet</label>
            <div class="blog-search-field">
                <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
                <input id="blog-search-input" name="q" type="search" value="{{ search }}" placeholder="AML, DORA, fonds, formation…" autocomplete="off">
                {% if selectedCategory %}<input type="hidden" name="category" value="{{ selectedCategory }}">{% endif %}
                <button type="submit">Rechercher</button>
            </div>
        </form>
        <nav class="blog-categories" aria-label="Filtrer par catégorie">
            <a href="{{ path('app_blog_index', search ? { q: search } : {}) }}"{% if not selectedCategory %} aria-current="page"{% endif %}>Tous</a>
            {% for category in categories %}
                <a href="{{ path('app_blog_index', { category: category, q: search ?: null }) }}"{% if selectedCategory == category %} aria-current="page"{% endif %}>{{ category }}</a>
            {% endfor %}
        </nav>
        {% if search or selectedCategory %}
            <div class="blog-results-heading">
                <p><strong>{{ posts|length }}</strong> résultat{{ posts|length > 1 ? 's' }}{% if search %} pour « {{ search }} »{% endif %}</p>
                <a href="{{ path('app_blog_index') }}">Effacer les filtres</a>
            </div>
        {% endif %}
    </section>

    {% if featured %}
        <section class="blog-featured" aria-labelledby="featured-title" data-reveal-target="item">
            <a href="{{ path('app_blog_show', { slug: featured.slug }) }}" class="blog-featured-link">
                <div class="blog-featured-media">
                    {% if featured.featuredImage %}<img src="{{ asset(featured.featuredImage) }}" alt="{{ featured.featuredImageAlt }}">{% endif %}
                    <span>À la une</span>
                </div>
                <div class="blog-featured-copy">
                    <div class="blog-card-meta"><span>{{ featured.category }}</span><time datetime="{{ featured.publishedAt|date('Y-m-d') }}">{{ featured.publishedAt|date('d.m.Y') }}</time></div>
                    <h2 id="featured-title">{{ featured.title }}</h2>
                    <p>{{ featured.excerpt }}</p>
                    <div class="blog-featured-footer">
                        <span>{{ featured.readingTime }} min de lecture</span>
                        <strong>Lire l’analyse <span aria-hidden="true">↗</span></strong>
                    </div>
                </div>
            </a>
        </section>
    {% endif %}

    {% if communityPosts %}
        <section class="community-network" aria-labelledby="community-network-title" data-reveal-target="item">
            <header class="community-network-heading">
                <div>
                    <span>En direct de la plateforme</span>
                    <h2 id="community-network-title">Le fil de notre communauté.</h2>
                </div>
                <p>Lisez librement les publications de nos membres. Un compte e-learning est demandé uniquement pour réagir ou commenter.</p>
            </header>
            <div class="community-network-layout">
                <div class="community-feed" role="feed" aria-label="Publications de la communauté">
                    {% for post in communityPosts %}
                        <article class="community-feed-card" data-controller="community-feed" data-community-feed-registration-url-value="{{ post.registrationUrl }}">
                            <header class="community-feed-author">
                                {% set usesDefaultAvatar = not post.authorAvatarUrl or post.authorAvatarUrl ends with '/images/User.svg' %}
                                <img src="{{ usesDefaultAvatar ? asset('images/User.svg') : post.authorAvatarUrl }}" class="{{ usesDefaultAvatar ? 'community-avatar-default' : '' }}" alt="" loading="lazy">
                                <div>
                                    <strong>{{ post.authorName }}</strong>
                                    <small>Publié dans la communauté · <time datetime="{{ post.publishedAt|date('c') }}">{{ post.publishedAt|date('d.m.Y à H:i') }}</time></small>
                                </div>
                                <span class="community-feed-origin">E-learning</span>
                            </header>
                            <div class="community-feed-copy">
                                {% set hasMoreContent = post.content|striptags|length > post.excerpt|length %}
                                <h3><a href="{{ path('app_community_post_show', {slug: post.slug}) }}">{{ post.title }}</a></h3>
                                <div data-community-feed-target="summary"><p>{{ post.excerpt }}</p></div>
                                {% if hasMoreContent %}
                                    <div class="community-feed-full" data-community-feed-target="content" hidden>{{ post.content|raw }}</div>
                                    <button type="button" class="community-feed-more" data-community-feed-target="moreButton" data-action="community-feed#toggleContent" aria-expanded="false">Voir plus</button>
                                {% endif %}
                            </div>
                            {% if post.mediaUrl %}
                                <a href="{{ path('app_community_post_show', {slug: post.slug}) }}" class="community-feed-media" aria-label="Lire la publication {{ post.title }}">
                                    {% if post.mediaType == 'video' %}
                                        <video muted playsinline preload="metadata"><source src="{{ post.mediaUrl }}"></video><span>Voir la vidéo</span>
                                    {% else %}
                                        <img src="{{ post.mediaUrl }}" alt="{{ post.title }}" loading="lazy">
                                    {% endif %}
                                </a>
                            {% endif %}
                            <div class="community-feed-summary">
                                <span><b>{{ post.likesCount }}</b> réaction{{ post.likesCount > 1 ? 's' }}</span>
                                <span><b>{{ post.commentsCount }}</b> commentaire{{ post.commentsCount > 1 ? 's' }}</span>
                            </div>
                            <footer class="community-feed-actions">
                                <a href="{{ post.registrationUrl }}" rel="nofollow"><span aria-hidden="true">♡</span> J’aime</a>
                                <button type="button" data-community-feed-target="commentsButton" data-action="community-feed#toggleComments" aria-expanded="false"><span aria-hidden="true">◌</span> Commenter</button>
                                <a href="{{ path('app_community_post_show', {slug: post.slug}) }}">Lire <span aria-hidden="true">→</span></a>
                            </footer>
                            <section class="community-feed-comments" data-community-feed-target="comments" aria-label="Commentaires de la publication" hidden>
                                <header><strong>Commentaires</strong><span>{{ post.commentsCount }}</span></header>
                                {% if post.latestComments %}
                                    <div class="community-feed-comments-list">
                                        {% for comment in post.latestComments %}
                                            <article>
                                                <span>{{ comment.author|slice(0, 1)|upper }}</span>
                                                <div><strong>{{ comment.author }}</strong><p>{{ comment.content }}</p></div>
                                                {% if comment.likes %}<small>♡ {{ comment.likes }}</small>{% endif %}
                                            </article>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <p class="community-feed-no-comment">Aucun commentaire pour le moment. Lancez la discussion.</p>
                                {% endif %}
                                <form class="community-feed-comment-form" data-action="submit->community-feed#join">
                                    <span aria-hidden="true">LC</span>
                                    <label><span class="sr-only">Ajouter un commentaire</span><input type="text" placeholder="Ajouter un commentaire…" required></label>
                                    <button type="submit">Publier</button>
                                </form>
                            </section>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    <section class="blog-feed" aria-labelledby="blog-feed-title" data-reveal-target="item">
        <header class="blog-feed-heading">
            <div><span>Perspectives</span><h2 id="blog-feed-title">Toutes nos analyses</h2></div>
            <p>{{ posts|length }} publication{{ posts|length > 1 ? 's' }}</p>
        </header>
        {% if posts %}
            <div class="blog-grid">
                {% for post in posts %}{% include 'blog/_card.html.twig' with { post: post } only %}{% endfor %}
            </div>
        {% else %}
            <div class="blog-empty">
                <span aria-hidden="true">⌕</span>
                <h2>Aucune analyse trouvée</h2>
                <p>Essayez une autre expression ou explorez l’ensemble des catégories.</p>
                <a class="button button-primary" href="{{ path('app_blog_index') }}">Voir tous les articles</a>
            </div>
        {% endif %}
    </section>

    <section class="blog-newsletter" data-reveal-target="item">
        <div><span class="eyebrow">Besoin d’un regard expert ?</span><h2>Transformons l’analyse<br>en action.</h2></div>
        <div><p>Une question réglementaire, un besoin de renfort ou un projet de formation ? Échangez directement avec notre équipe.</p><a class="button button-primary" href="{{ path('app_contact') }}">Parler à un expert <span class="arrow-box">↗</span></a></div>
    </section>
</main>
{% endblock %}
