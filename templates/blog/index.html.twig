{% extends 'base.html.twig' %}

{% block title %}Finance and compliance insights in Luxembourg | Les Consultants{% endblock %}
{% block meta_description %}Analysis and guidance on compliance, finance, risk management, digital transformation and training in Luxembourg.{% endblock %}
{% block canonical_url %}{{ url('app_blog_index') }}{% endblock %}
{% block robots %}{% if search or selectedCategory %}noindex,follow{% else %}index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1{% endif %}{% endblock %}

{% block body %}
<main id="contenu" class="container frame blog-index">
    <section class="blog-hero" data-reveal-target="item">
        <div class="blog-hero-orb blog-hero-orb-one" aria-hidden="true"></div>
        <div class="blog-hero-orb blog-hero-orb-two" aria-hidden="true"></div>
        <nav class="breadcrumb breadcrumb-on-dark" aria-label="Breadcrumb">
            <a href="{{ path('app_home') }}">Home</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Blog</span>
        </nav>
        <div class="blog-hero-grid">
            <div>
                <div class="eyebrow">Insights for regulated professions</div>
                <h1>Understand today.<br><span>Decide with confidence.</span></h1>
            </div>
            <div class="blog-hero-copy">
                <p>Regulatory analysis, industry trends and practical guidance for financial-sector organisations in Luxembourg.</p>
                <div class="blog-hero-signals" aria-label="Blog topics">
                    <span>Finance</span><span>Compliance</span><span>Risk</span><span>Training</span>
                </div>
            </div>
        </div>
    </section>

    <section class="blog-discovery" aria-label="Search the blog" data-reveal-target="item">
        <form class="blog-search" method="get" action="{{ path('app_blog_index') }}">
            <label for="blog-search-input">Search for a topic</label>
            <div class="blog-search-field">
                <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg>
                <input id="blog-search-input" name="q" type="search" value="{{ search }}" placeholder="AML, DORA, funds, training…" autocomplete="off">
                {% if selectedCategory %}<input type="hidden" name="category" value="{{ selectedCategory }}">{% endif %}
                <button type="submit">Search</button>
            </div>
        </form>
        <nav class="blog-categories" aria-label="Filter by category">
            <a href="{{ path('app_blog_index', search ? { q: search } : {}) }}"{% if not selectedCategory %} aria-current="page"{% endif %}>All</a>
            {% for category in categories %}
                <a href="{{ path('app_blog_index', { category: category, q: search ?: null }) }}"{% if selectedCategory == category %} aria-current="page"{% endif %}>{{ category }}</a>
            {% endfor %}
        </nav>
        {% if search or selectedCategory %}
            <div class="blog-results-heading">
                <p><strong>{{ posts|length }}</strong> result{{ posts|length != 1 ? "s" }}{% if search %} for “{{ search }}”{% endif %}</p>
                <a href="{{ path('app_blog_index') }}">Clear filters</a>
            </div>
        {% endif %}
    </section>

    {% if featured %}
        <section class="blog-featured" aria-labelledby="featured-title" data-reveal-target="item">
            <a href="{{ path('app_blog_show', { slug: featured.slug }) }}" class="blog-featured-link">
                <div class="blog-featured-media">
                    {% if featured.featuredImage %}<img src="{{ asset(featured.featuredImage) }}" alt="{{ featured.featuredImageAlt }}">{% endif %}
                    <span>Featured</span>
                </div>
                <div class="blog-featured-copy">
                    <div class="blog-card-meta"><span>{{ featured.category }}</span><time datetime="{{ featured.publishedAt|date('Y-m-d') }}">{{ featured.publishedAt|date('d.m.Y') }}</time></div>
                    <h2 id="featured-title">{{ featured.title }}</h2>
                    <p>{{ featured.excerpt }}</p>
                    <div class="blog-featured-footer">
                        <span>{{ featured.readingTime }} min read</span>
                        <strong>Read the analysis <span aria-hidden="true">↗</span></strong>
                    </div>
                </div>
            </a>
        </section>
    {% endif %}

    {% if communityPosts %}
        <section class="community-network" aria-labelledby="community-network-title" data-reveal-target="item">
            <header class="community-network-heading">
                <div>
                    <span>Live from the platform</span>
                    <h2 id="community-network-title">Our community feed.</h2>
                </div>
                <p>Read posts from our members freely. An e-learning account is only required to react or comment.</p>
            </header>
            <div class="community-network-layout">
                <div class="community-feed" role="feed" aria-label="Community posts">
                    {% for post in communityPosts %}
                        <article class="community-feed-card" data-controller="community-feed" data-community-feed-registration-url-value="{{ post.registrationUrl }}">
                            <header class="community-feed-author">
                                {% set usesDefaultAvatar = not post.authorAvatarUrl or post.authorAvatarUrl ends with '/images/User.svg' %}
                                <img src="{{ usesDefaultAvatar ? asset('images/User.svg') : post.authorAvatarUrl }}" class="{{ usesDefaultAvatar ? 'community-avatar-default' : '' }}" alt="" loading="lazy">
                                <div>
                                    <strong>{{ post.authorName }}</strong>
                                    <small>Published in the community · <time datetime="{{ post.publishedAt|date('c') }}">{{ post.publishedAt|date('d.m.Y') }} at {{ post.publishedAt|date('H:i') }}</time></small>
                                </div>
                                <span class="community-feed-origin">E-learning</span>
                            </header>
                            <div class="community-feed-copy">
                                {% set hasMoreContent = post.content|striptags|length > post.excerpt|length %}
                                <h3><a href="{{ path('app_community_post_show', {slug: post.slug}) }}">{{ post.title }}</a></h3>
                                <div data-community-feed-target="summary"><p>{{ post.excerpt }}</p></div>
                                {% if hasMoreContent %}
                                    <div class="community-feed-full" data-community-feed-target="content" hidden>{{ post.content|raw }}</div>
                                    <button type="button" class="community-feed-more" data-community-feed-target="moreButton" data-action="community-feed#toggleContent" aria-expanded="false">Read more</button>
                                {% endif %}
                            </div>
                            {% if post.mediaUrl %}
                                <a href="{{ path('app_community_post_show', {slug: post.slug}) }}" class="community-feed-media" aria-label="Read the post {{ post.title }}">
                                    {% if post.mediaType == 'video' %}
                                        <video muted playsinline preload="metadata"><source src="{{ post.mediaUrl }}"></video><span>Watch video</span>
                                    {% else %}
                                        <img src="{{ post.mediaUrl }}" alt="{{ post.title }}" loading="lazy">
                                    {% endif %}
                                </a>
                            {% endif %}
                            <div class="community-feed-summary">
                                <span><b>{{ post.likesCount }}</b> reaction{{ post.likesCount != 1 ? 's' }}</span>
                                <span><b>{{ post.commentsCount }}</b> comment{{ post.commentsCount != 1 ? 's' }}</span>
                            </div>
                            <footer class="community-feed-actions">
                                <a href="{{ post.registrationUrl }}" rel="nofollow"><span aria-hidden="true">♡</span> Like</a>
                                <button type="button" data-community-feed-target="commentsButton" data-action="community-feed#toggleComments" aria-expanded="false"><span aria-hidden="true">◌</span> Comment</button>
                                <a href="{{ path('app_community_post_show', {slug: post.slug}) }}">Read <span aria-hidden="true">→</span></a>
                            </footer>
                            <section class="community-feed-comments" data-community-feed-target="comments" aria-label="Post comments" hidden>
                                <header><strong>Comments</strong><span>{{ post.commentsCount }}</span></header>
                                {% if post.latestComments %}
                                    <div class="community-feed-comments-list">
                                        {% for comment in post.latestComments %}
                                            <article>
                                                <span>{{ comment.author|slice(0, 1)|upper }}</span>
                                                <div><strong>{{ comment.author }}</strong><p>{{ comment.content }}</p></div>
                                                {% if comment.likes %}<small>♡ {{ comment.likes }}</small>{% endif %}
                                            </article>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <p class="community-feed-no-comment">No comments yet. Start the conversation.</p>
                                {% endif %}
                                <form class="community-feed-comment-form" data-action="submit->community-feed#join">
                                    <span aria-hidden="true">LC</span>
                                    <label><span class="sr-only">Add a comment</span><input type="text" placeholder="Add a comment…" required></label>
                                    <button type="submit">Post</button>
                                </form>
                            </section>
                        </article>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    <section class="blog-feed" aria-labelledby="blog-feed-title" data-reveal-target="item">
        <header class="blog-feed-heading">
            <div><span>Perspectives</span><h2 id="blog-feed-title">All our insights</h2></div>
            <p>{{ posts|length }} post{{ posts|length != 1 ? 's' }}</p>
        </header>
        {% if posts %}
            <div class="blog-grid">
                {% for post in posts %}{% include 'blog/_card.html.twig' with { post: post } only %}{% endfor %}
            </div>
        {% else %}
            <div class="blog-empty">
                <span aria-hidden="true">⌕</span>
                <h2>No insights found</h2>
                <p>Try another search term or browse all categories.</p>
                <a class="button button-primary" href="{{ path('app_blog_index') }}">View all articles</a>
            </div>
        {% endif %}
    </section>

    <section class="blog-newsletter" data-reveal-target="item">
        <div><span class="eyebrow">Need an expert perspective?</span><h2>Turn insight<br>into action.</h2></div>
        <div><p>A regulatory question, additional support or a training project? Speak directly with our team.</p><a class="button button-primary" href="{{ path('app_contact') }}">Speak to an expert <span class="arrow-box">↗</span></a></div>
    </section>
</main>
{% endblock %}
