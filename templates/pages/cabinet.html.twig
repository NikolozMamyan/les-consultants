{% extends 'base.html.twig' %}

{% block title %}Financial consulting firm in Luxembourg | Les Consultants{% endblock %}
{% block meta_description %}Discover Les Consultants, an independent Luxembourg firm specialising in consulting and training for financial and regulated professions.{% endblock %}
{% block og_image %}{{ absolute_url(asset('images/cabinet-luxembourg.webp')) }}{% endblock %}
{% block og_image_alt %}Les Consultants firm in Luxembourg{% endblock %}

{% block body %}
<main id="contenu" class="container frame">
<section class="page-intro" data-section="hero" data-section-label="About the firm" data-reveal-target="item">
<nav class="breadcrumb" aria-label="Breadcrumb">
<a href="{{ path('app_home') }}">Home</a>
<span aria-hidden="true">/</span>
<span aria-current="page">About us</span>
</nav>
<div class="eyebrow">About us</div>
<h1>A trusted partner<br>
<span class="accent">for your critical assignments.</span>
</h1>
<p class="lead">Les Consultants is an independent consulting and training firm specialising in regulated professions in Luxembourg.</p>
<div class="wide-photo">
<img src="{{ asset('images/cabinet-luxembourg.webp') }}" alt="Two consultants in front of contemporary architecture in Luxembourg" width="1536" height="1024">
<div class="photo-caption">
<small data-theme-static>LES CONSULTANTS · CONSULTING &amp; TRAINING</small>
<p>Finance expertise.<br>And compliance.</p>
</div>
</div>
</section>
<section class="section about-statement" data-section="mission" data-section-label="Our mission" data-reveal-target="item">
<div>
<div class="eyebrow">About us</div>
<h2>A trusted partner<br>for your critical assignments.</h2>
</div>
<div>
<p>At LES CONSULTANTS, we connect financial-sector organisations in Luxembourg with our specialised consultants.</p>
<p>Our approach is built on listening, responsiveness and a thorough understanding of regulatory and operational challenges.</p>
<a class="text-link" href="{{ path('app_contact') }}">Let’s discuss your project<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M5 12h14m-5-5 5 5-5 5"/>
</svg>
</a>
</div>
</section>
<section class="section" data-section="values" data-section-label="What sets us apart" data-reveal-target="item">
<div class="section-heading">
<div>
<div class="eyebrow">Our mission</div>
<h2>What makes us<br>different.</h2>
</div>
</div>
<div class="values-grid">
<div>
<span class="value-number">01 / RESPONSIVENESS</span>
<h3>Responsive, fast sourcing</h3>
<p>We present carefully selected, validated profiles available within 48 hours.</p>
</div>
<div>
<span class="value-number">02 / EXPERTISE</span>
<h3>Understanding your business challenges</h3>
<p>Specialised expertise in compliance and finance enables us to provide consultants who can contribute immediately.</p>
</div>
<div>
<span class="value-number">03 / SUPPORT</span>
<h3>Ongoing support</h3>
<p>Personalised support and a simple, fast and transparent process throughout the assignment.</p>
</div>
</div>
</section>
<section class="section about-teaser" data-section="reseau" data-section-label="Join the network" data-reveal-target="item">
<div class="about-image about-image-network">
<img src="{{ asset('images/reseau-consultants.webp') }}" alt="Three experienced consultants working together on a project" width="1122" height="1402" loading="lazy">
<span class="image-stamp">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM3 12h18M12 3c5 5 5 13 0 18-5-5-5-13 0-18Z"/>
</svg>Luxembourg · Belgique · Europe</span>
</div>
<div>
<div class="eyebrow">Are you a consultant?</div>
<h2>Your expertise deserves<br>the right project.</h2>
<p>Join our network to receive targeted assignments aligned with your expertise. Showcase your skills and benefit from tailored support.</p>
<div class="actions actions-spaced">
<a class="button button-primary" href="{{ path('app_contact', { profil: 'consultant' }) }}">Contact us<span class="arrow-box">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M5 12h14m-5-5 5 5-5 5"/>
</svg>
</span>
</a>
</div>
</div>
</section>
<section class="cta-section" data-reveal-target="item">
<div class="eyebrow">Ready to take the next step?</div>
<h2>Tell us what you need,<br><span class="accent">we’ll take care of the rest.</span></h2>
<p>Targeted profiles ready to contribute to your assignments in Luxembourg.</p>
<div class="actions">
<a class="button button-primary" href="{{ path('app_deposit', { form: 'mission' }) }}">Submit a mission<span class="arrow-box">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M5 12h14m-5-5 5 5-5 5"/>
</svg>
</span>
</a>
<a class="button button-quiet" href="{{ path('app_contact', { profil: 'consultant' }) }}">I am a consultant <svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M6 18 18 6M6 6h12v12"/>
</svg>
</a>
</div>
</section>
</main>
{% endblock %}
