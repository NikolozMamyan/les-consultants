{% extends 'base.html.twig' %}
{% import 'macros/ui.html.twig' as ui %}

{% block title %}Submit a consulting assignment in Luxembourg | Les Consultants{% endblock %}
{% block meta_description %}Submit your consulting assignment in Luxembourg and quickly receive specialised consultant profiles tailored to your needs.{% endblock %}

{% block body %}
<main id="contenu" class="container frame" data-controller="submission-modal" data-submission-modal-open-value="{{ autoOpen ? 'true' : 'false' }}">
    <section class="page-intro" data-reveal-target="item">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="{{ path('app_home') }}">Home</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Submit a mission</span>
        </nav>
        <div class="eyebrow">Your requirements</div>
        <h1>The right expertise.<br><span class="accent">In the right place.</span></h1>
        <p class="lead">A few details are all we need to start finding the right expert.</p>
    </section>

    <section class="section deposit-section" data-reveal-target="item">
        <div class="service-grid deposit-grid deposit-grid-single">
            <article class="service-card deposit-card">
                <span class="service-icon">{{ ui.icon('briefcase') }}</span>
                <div class="eyebrow">Your requirements</div>
                <h2>Submit your mission</h2>
                <p>Tell us about your assignment in a few clicks and quickly find the right consultant.</p>
                <ul class="checklist">
                    <li>{{ ui.icon('check') }} Describe your requirements and priorities</li>
                    <li>{{ ui.icon('check') }} Profiles available within 48 hours</li>
                    <li>{{ ui.icon('check') }} End-to-end assignment management</li>
                </ul>
                <button class="button button-primary" type="button" data-action="submission-modal#open">Submit your mission <span class="arrow-box">{{ ui.icon('arrow') }}</span></button>
            </article>
        </div>
    </section>

    <div class="dark-chapter">
        {% include 'partials/_faq.html.twig' %}
    </div>

    {% include 'partials/_submission_modal.html.twig' %}
</main>
{% endblock %}
