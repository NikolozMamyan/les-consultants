{% extends 'base.html.twig' %}

{% block title %}Finance and compliance consulting in Luxembourg | Les Consultants{% endblock %}
{% block meta_description %}Strengthen your teams with external consultants specialising in compliance, internal control, legal services, fund administration and digital transformation in Luxembourg.{% endblock %}
{% block og_image %}{{ absolute_url(asset('images/experts-finance-conformite.webp')) }}{% endblock %}
{% block og_image_alt %}Finance and compliance experts brought together by Les Consultants{% endblock %}

{% block body %}
<main id="contenu" class="container frame expertises-page">
<section class="page-intro" data-section="hero" data-section-label="Expertise introduction" data-reveal-target="item">
<nav class="breadcrumb" aria-label="Breadcrumb">
<a href="{{ path('app_home') }}">Home</a>
<span aria-hidden="true">/</span>
<span aria-current="page">Our expertise</span>
</nav>
<div class="service-chapter-divider service-chapter-divider-light">
<span aria-hidden="true"></span>
<div><small>01</small><strong>Consulting</strong></div>
<span aria-hidden="true"></span>
</div>
<div class="intro-grid">
<div>
<h1>External consultants<br>
<span class="accent">for your business challenges.</span>
</h1>
<p class="lead">We support financial-sector organisations in Luxembourg with specialised external consultants for targeted, business-critical assignments.</p>
<a class="button button-primary" href="{{ path('app_deposit', { form: 'mission' }) }}">Submit a mission<span class="arrow-box">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M5 12h14m-5-5 5 5-5 5"/>
</svg>
</span>
</a>
</div>
<div class="intro-art" aria-hidden="true">
<div class="orbit">
</div>
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="m12 3 10 5-10 5L2 8l10-5Zm-10 9 10 5 10-5M2 16l10 5 10-5"/>
</svg>
<span class="pill green">Finance & compliance</span>
<span class="pill purple">Targeted profiles</span>
</div>
</div>
</section>
<section class="section" data-section="services" data-section-label="Our areas of expertise" data-controller="filter" data-reveal-target="item">
<div class="section-heading">
<div>
<div class="eyebrow">Our expertise</div>
<h2>Targeted expertise.<br>Practical solutions.</h2>
</div>
</div>
<div class="expertise-tabs" aria-label="Filter expertise areas">
<button class="filter-button" type="button" data-filter-target="button" data-action="filter#select" data-filter-category-param="all" aria-pressed="true">All expertise</button>
<button class="filter-button" type="button" data-filter-target="button" data-action="filter#select" data-filter-category-param="Compliance" aria-pressed="false">Compliance</button>
<button class="filter-button" type="button" data-filter-target="button" data-action="filter#select" data-filter-category-param="Finance" aria-pressed="false">Finance</button>
<button class="filter-button" type="button" data-filter-target="button" data-action="filter#select" data-filter-category-param="Transformation" aria-pressed="false">Transformation</button>
</div>
<div class="service-grid">
<article class="service-card" id="compliance" data-category="Compliance" data-filter-target="card">
<span class="service-icon">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="m12 3 8 3v6c0 5-8 9-8 9s-8-4-8-9V6l8-3Zm-4 9 3 3 5-6"/>
</svg>
</span>
<h3>Compliance expertise</h3>
<p>We provide specialised consultants to support financial institutions with anti-money laundering (AML), know-your-customer (KYC) and wider compliance obligations.</p>
<div class="tag-list">
<span class="pill">AML / CFT</span>
<span class="pill">KYC</span>
<span class="pill">Compliance Officer</span>
</div>
<a class="text-link" href="{{ path('app_contact', { expertise: 'compliance' }) }}">Discuss your requirements<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M5 12h14m-5-5 5 5-5 5"/>
</svg>
</a>
</article>
<article class="service-card" id="finance" data-category="Finance" data-filter-target="card">
<span class="service-icon">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M4 3v17h17M8 15v-4m5 4V7m5 8V5"/>
</svg>
</span>
<h3>Fund administration services</h3>
<p>We provide consultants specialising in fund accounting, NAV oversight, financial reporting and middle-office functions for interim assignments, team support or specific projects.</p>
<div class="tag-list">
<span class="pill">Fund Accounting</span>
<span class="pill">NAV Oversight</span>
<span class="pill">Reporting</span>
</div>
<a class="text-link" href="{{ path('app_contact', { expertise: 'finance' }) }}">Discuss your requirements<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M5 12h14m-5-5 5 5-5 5"/>
</svg>
</a>
</article>
<article class="service-card" id="risques" data-category="Compliance" data-filter-target="card">
<span class="service-icon">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-4 0a5 5 0 1 1-10 0 5 5 0 0 1 10 0Zm-4 0h-2"/>
</svg>
</span>
<h3>Internal control & governance</h3>
<p>Our audit and internal-control consultants assess, improve and secure financial, operational and regulatory processes.</p>
<div class="tag-list">
<span class="pill">Internal audit</span>
<span class="pill">Risk & Control</span>
<span class="pill">Governance</span>
</div>
<a class="text-link" href="{{ path('app_contact', { expertise: 'risques' }) }}">Discuss your requirements<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M5 12h14m-5-5 5 5-5 5"/>
</svg>
</a>
</article>
<article class="service-card" id="juridique" data-category="Compliance" data-filter-target="card">
<span class="service-icon">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M14 2H4v20h16V8l-6-6Zm0 0v6h6M8 13h8m-8 4h6"/>
</svg>
</span>
<h3>Legal &amp; regulatory services</h3>
<p>Our legal and compliance consultants assist with contract drafting, regulatory analysis and legal-risk management.</p>
<div class="tag-list">
<span class="pill">Legal Officer</span>
<span class="pill">Funds</span>
<span class="pill">Private banking</span>
</div>
<a class="text-link" href="{{ path('app_contact', { expertise: 'juridique' }) }}">Discuss your requirements<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M5 12h14m-5-5 5 5-5 5"/>
</svg>
</a>
</article>
<article class="service-card" id="digital" data-category="Transformation" data-filter-target="card">
<span class="service-icon">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="m8 7-5 5 5 5m8-10 5 5-5 5m-3-12-2 14"/>
</svg>
</span>
<h3>Digital transformation services (IT)</h3>
<p>We provide IT experts to strengthen your teams or lead projects across governance and compliance, project management, ITSM optimisation, operations, infrastructure and cybersecurity.</p>
<div class="tag-list">
<span class="pill">Project management</span>
<span class="pill">Cybersecurity</span>
<span class="pill">IT governance</span>
</div>
<a class="text-link" href="{{ path('app_contact', { expertise: 'digital' }) }}">Discuss your requirements<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M5 12h14m-5-5 5 5-5 5"/>
</svg>
</a>
</article>
<article class="service-card custom" data-category="all" data-filter-target="card">
<span class="service-icon">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="m12 2 2.5 7.5L22 12l-7.5 2.5L12 22l-2.5-7.5L2 12l7.5-2.5L12 2Z"/>
</svg>
</span>
<h3>Do you have a different requirement?</h3>
<p>We design tailored solutions for non-standard or cross-sector requirements.</p>
<a class="button button-primary" href="{{ path('app_deposit', { form: 'mission' }) }}">Submit a mission<span class="arrow-box">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M5 12h14m-5-5 5 5-5 5"/>
</svg>
</span>
</a>
</article>
</div>
</section>
<section class="training-chapter-bridge" data-section="training-divider" data-section-label="Training chapter">
<div class="service-chapter-divider service-chapter-divider-dark">
<span aria-hidden="true"></span>
<div><small>02</small><strong>Training</strong></div>
<span aria-hidden="true"></span>
</div>
</section>
<section class="digital-platform-section" data-section="plateforme" data-section-label="E-learning platform" data-reveal-target="item">
<div class="platform-ambient" aria-hidden="true"></div>
<div class="platform-copy">
<div class="eyebrow prominent-eyebrow">Our digital solution</div>
<h2>Regulatory training.<br><span>Available everywhere.</span></h2>
<p class="platform-lead">An e-learning platform designed for professionals and regulated teams in Luxembourg. Deploy training, monitor progress and centralise certificates in one clear, secure space.</p>

<div class="platform-benefits">
<div class="platform-benefit">
<span class="platform-benefit-icon">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 5h16v14H4V5Zm4 4h8M8 13h5"/></svg>
</span>
<div><strong>30+ professional modules</strong><small>Compliance, AML/CFT, risk, GDPR and cybersecurity.</small></div>
</div>
<div class="platform-benefit">
<span class="platform-benefit-icon">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M4 19V9m5 10V5m5 14v-7m5 7V3"/></svg>
</span>
<div><strong>Centralised monitoring</strong><small>Progress, completion and certificates visible in real time.</small></div>
</div>
<div class="platform-benefit">
<span class="platform-benefit-icon">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M8 3h8v18H8V3Zm3 15h2M4 7H2v10h2m16-10h2v10h-2"/></svg>
</span>
<div><strong>Web &amp; mobile</strong><small>Your learning paths remain available 24/7, in the office and on the move.</small></div>
</div>
</div>

<a class="platform-main-link" href="https://elearning-lesconsultants.com/" target="_blank" rel="noopener noreferrer">Explore the platform<span>
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
</span></a>

<div class="app-downloads">
<span class="app-downloads-label">Take your training anywhere</span>
<div class="store-badges">
<a class="store-badge" href="https://apps.apple.com/fr/app/les-consultants-e-learning/id6761538535" target="_blank" rel="noopener noreferrer" aria-label="Download Les Consultants e-learning from the App Store">
<svg class="store-logo store-logo-apple" aria-hidden="true" viewBox="0 0 24 24"><path d="M17.1 12.6c0-2.8 2.3-4.2 2.4-4.3a5.2 5.2 0 0 0-4.1-2.2c-1.8-.2-3.4 1-4.3 1s-2.3-1-3.8-.9a5.6 5.6 0 0 0-4.7 2.9c-2 3.5-.5 8.7 1.4 11.5.9 1.4 2.1 3 3.6 2.9 1.5 0 2-1 3.8-1s2.3 1 3.8 1c1.6 0 2.6-1.4 3.5-2.8a12.5 12.5 0 0 0 1.6-3.4 5 5 0 0 1-3.2-4.7ZM14.2 4.2A5 5 0 0 0 15.4.6a5 5 0 0 0-3.3 1.7 4.7 4.7 0 0 0-1.2 3.5 4.2 4.2 0 0 0 3.3-1.6Z"/></svg>
<span><small>Download on the</small><strong>App Store</strong></span>
<svg class="store-arrow" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
</a>
<a class="store-badge" href="https://play.google.com/store/apps/details?id=com.mycompany.lesconsultantselearning&amp;hl=en" target="_blank" rel="noopener noreferrer" aria-label="Download Les Consultants from Google Play">
<svg class="store-logo store-logo-play" aria-hidden="true" viewBox="0 0 32 36">
<path class="play-blue" d="M3 3.3v29.4L18.7 18 3 3.3Z"/>
<path class="play-green" d="m3.8 2.5 18.6 10.7-3.7 4.8L3 3.3l.8-.8Z"/>
<path class="play-yellow" d="m18.7 18 3.7 4.8L3.8 33.5l-.8-.8L18.7 18Z"/>
<path class="play-red" d="m22.4 13.2 5.1 2.9c1 .6 1 1.3 0 1.8l-5.1 2.9-3.7-2.8 3.7-4.8Z"/>
</svg>
<span><small>Get it on</small><strong>Google Play</strong></span>
<svg class="store-arrow" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
</a>
</div>
</div>
</div>

<div class="platform-showcase">
<div class="platform-browser">
<div class="platform-browser-bar" aria-hidden="true">
<span></span><span></span><span></span>
<div><i></i> elearning-lesconsultants.com</div>
</div>
<div class="platform-screen">
<img src="{{ asset('images/plateforme.webp') }}" alt="Les Consultants e-learning dashboard showing courses, progress and certificates" width="1920" height="1690" loading="lazy">
</div>
</div>
<div class="platform-floating-card platform-floating-modules"><span>Catalogue</span><strong>30+ modules</strong><small>Updated regularly</small></div>
<div class="platform-floating-card platform-floating-progress">
<span>Team progress</span>
<strong>Real-time monitoring</strong>
<i aria-hidden="true"><b></b></i>
</div>
<div class="platform-device-chip"><span></span> Available on all your devices</div>
</div>
</section>
{% if catalogAvailable %}
<section class="catalogue-bridge" aria-label="Training catalogue">
<a class="button button-primary catalogue-button" href="{{ path('app_catalog') }}">Catalogue<span class="arrow-box">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path d="M5 12h14m-5-5 5 5-5 5"/></svg>
</span></a>
</section>
{% endif %}
<section class="cta-section" data-reveal-target="item">
<div class="eyebrow">Ready to get started?</div>
<h2>Need a qualified consultant<br><span class="accent">to strengthen your team?</span></h2>
<p>Tell us what you need and we’ll take care of the rest.</p>
<div class="actions">
<a class="button button-primary" href="https://elearning-lesconsultants.com">Get started<span class="arrow-box">
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M5 12h14m-5-5 5 5-5 5"/>
</svg>
</span>
</a>
<a class="button button-quiet" href="{{ path('app_contact', { profil: 'consultant' }) }}">I am a consultant <svg class="icon" aria-hidden="true" viewBox="0 0 24 24">
<path d="M6 18 18 6M6 6h12v12"/>
</svg>
</a>
</div>
</section>
</main>
{% endblock %}
