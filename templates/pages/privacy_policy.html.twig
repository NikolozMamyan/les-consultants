{% extends 'base.html.twig' %}

{% block title %}Privacy policy | Les Consultants{% endblock %}
{% block meta_description %}Learn how Les Consultants collects, uses and protects personal data in accordance with the GDPR.{% endblock %}

{% block body %}
<main id="contenu" class="container frame legal-page">
    <header class="legal-hero" data-reveal-target="item">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="{{ path('app_home') }}">Home</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Privacy policy</span>
        </nav>
        <div class="eyebrow">Personal data</div>
        <h1>Privacy <span class="accent">policy.</span></h1>
        <p class="legal-updated">Last updated: May 2025</p>
    </header>

    <article class="legal-content" data-reveal-target="item">
        <section>
            <span class="legal-number">01</span>
            <div>
                <h2>Data controller</h2>
                <p>The controller responsible for personal data collected through this website is:</p>
                <p><strong>LES CONSULTANTS SARL</strong><br>
                    1 Simmerfarm, L-8363 Simmerfarm, Luxembourg<br>
                    Email : <a href="mailto:pruffin@les-consultants.lu">pruffin@les-consultants.lu</a>
                </p>
            </div>
        </section>

        <section>
            <span class="legal-number">02</span>
            <div>
                <h2>Data collected</h2>
                <p>The website collects personal data only through its forms:</p>
                <ul>
                    <li>Name</li>
                    <li>Email address</li>
                    <li>Telephone number, where provided</li>
                    <li>Information relating to the request or assignment</li>
                    <li>Free-text message</li>
                </ul>
                <p>This information is provided voluntarily by the user.</p>
            </div>
        </section>

        <section>
            <span class="legal-number">03</span>
            <div>
                <h2>Purposes of processing</h2>
                <p>The collected data is processed for the following purposes:</p>
                <ul>
                    <li>Responding to requests submitted through the forms</li>
                    <li>Processing assignment requests and consultant profiles</li>
                    <li>Producing audience statistics</li>
                </ul>
                <p>No data is transferred, sold or disclosed to third parties.</p>
            </div>
        </section>

        <section>
            <span class="legal-number">04</span>
            <div>
                <h2>Retention period</h2>
                <p>Data submitted through the forms is retained for a maximum of 12 months unless a legal obligation requires otherwise.</p>
            </div>
        </section>

        <section>
            <span class="legal-number">05</span>
            <div>
                <h2>Cookies and audience measurement</h2>
                <p>The website uses a technical cookie to compile anonymised audience statistics and monitor overall activity. Recorded information may include pages viewed, device type, browser and, where applicable, the referring website.</p>
                <p>Users can disable cookies through their browser settings.</p>
            </div>
        </section>

        <section>
            <span class="legal-number">06</span>
            <div>
                <h2>User rights</h2>
                <p>Under the General Data Protection Regulation (GDPR), you have the following rights:</p>
                <ul>
                    <li>Right of access</li>
                    <li>Right to rectification</li>
                    <li>Right to erasure</li>
                    <li>Right to restriction of processing</li>
                    <li>Right to object</li>
                </ul>
                <p>You can exercise these rights by writing to: <a href="mailto:pruffin@les-consultants.lu">pruffin@les-consultants.lu</a>.</p>
            </div>
        </section>

        <section>
            <span class="legal-number">07</span>
            <div>
                <h2>Security</h2>
                <p>LES CONSULTANTS implements the technical and organisational measures required to safeguard personal data processed through the website.</p>
            </div>
        </section>

        <section>
            <span class="legal-number">08</span>
            <div>
                <h2>Applicable law</h2>
                <p>This privacy policy is governed by Luxembourg law. Any dispute is subject to the exclusive jurisdiction of the courts of the Grand Duchy of Luxembourg.</p>
            </div>
        </section>
    </article>
</main>
{% endblock %}
