{% import 'macros/ui.html.twig' as ui %}
<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="{{ path('app_home') }}" aria-label="Les Consultants — Accueil">
            <span class="brand-symbol"><img src="{{ asset('images/logo-original.png') }}" alt="" width="94" height="94"></span>
            <span class="brand-name">les consultants<small>CONSEIL &amp; FORMATION</small></span>
        </a>
        <nav class="main-nav" id="navigation" aria-label="Navigation principale" data-navigation-target="menu">
            <a href="{{ path('app_home') }}"{% if page == 'home' %} aria-current="page"{% endif %} data-action="navigation#close">Accueil</a>
            <a href="{{ path('app_expertises') }}"{% if page == 'expertises' %} aria-current="page"{% endif %} data-action="navigation#close">Nos services</a>
            <a href="{{ path('app_cabinet') }}"{% if page == 'cabinet' %} aria-current="page"{% endif %} data-action="navigation#close">À propos</a>
            <a href="{{ path('app_contact') }}"{% if page == 'contact' %} aria-current="page"{% endif %} data-action="navigation#close">Contact</a>
            <a class="mobile-cta" href="{{ path('app_deposit', { form: 'mission' }) }}" data-action="navigation#close">Missions {{ ui.icon('arrow') }}</a>
        </nav>
        <div class="header-actions">
            <a class="text-link" href="https://elearning-lesconsultants.com/" target="_blank" rel="noopener noreferrer">E-learning {{ ui.icon('up') }}</a>
            <a class="button button-primary" href="{{ path('app_deposit', { form: 'mission' }) }}"{% if page == 'deposit' %} aria-current="page"{% endif %}>
                <span class="desktop-label">Déposer une mission</span><span class="mobile-label">Missions</span>
                <span class="arrow-box">{{ ui.icon('arrow') }}</span>
            </a>
            <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="navigation" aria-label="Ouvrir le menu" data-navigation-target="button" data-action="navigation#toggle">{{ ui.icon('menu') }}</button>
        </div>
    </div>
</header>
