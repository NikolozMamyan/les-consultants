{% import 'macros/ui.html.twig' as ui %}

<dialog class="submission-modal" data-submission-modal-target="dialog" data-action="click->submission-modal#backdrop close->submission-modal#closed" aria-labelledby="submission-modal-title">
    <div class="submission-modal-shell">
        <header class="submission-modal-header">
            <div>
                <div class="eyebrow">Votre besoin</div>
                <h2 id="submission-modal-title">Déposez votre mission</h2>
                <p>Quelques informations suffisent pour lancer la recherche du bon expert.</p>
            </div>
            <button class="submission-modal-close" type="button" data-action="submission-modal#close" aria-label="Fermer la fenêtre">
                <span aria-hidden="true"></span>
            </button>
        </header>

        <div class="submission-modal-body">
            <div data-submission-modal-target="flow">
                {{ form_start(missionForm, { attr: { novalidate: 'novalidate', 'data-action': 'submit->submission-modal#validateSubmit' } }) }}
                    {{ form_errors(missionForm) }}
                    <div class="submission-progress" aria-label="Progression du formulaire">
                        <span class="is-active"><i>1</i><small>Mission</small></span>
                        <span><i>2</i><small>Contact</small></span>
                        <span><i>3</i><small>Contexte</small></span>
                    </div>

                    <section class="submission-step" data-step="0">
                        <div class="submission-step-heading">
                            <span>01</span>
                            <div><h3>Parlez-nous de la mission</h3><p>Précisez le besoin pour orienter immédiatement notre recherche.</p></div>
                        </div>
                        <div class="form-grid">
                            <div class="field full">
                                {{ form_label(missionForm.missionTitle, 'Intitulé de la mission *') }}
                                {{ form_widget(missionForm.missionTitle, { attr: { placeholder: 'Ex. Compliance Officer — renfort AML/KYC', autocomplete: 'off', maxlength: 160 } }) }}
                                {{ form_errors(missionForm.missionTitle) }}
                            </div>
                            <div class="field full">
                                {{ form_label(missionForm.expertise, 'Expertise recherchée *') }}
                                {{ form_widget(missionForm.expertise) }}
                                {{ form_errors(missionForm.expertise) }}
                            </div>
                            <div class="field">
                                {{ form_label(missionForm.startDate, 'Date de début souhaitée') }}
                                {{ form_widget(missionForm.startDate) }}
                                {{ form_errors(missionForm.startDate) }}
                            </div>
                            <div class="field">
                                {{ form_label(missionForm.duration, 'Durée estimée *') }}
                                {{ form_widget(missionForm.duration) }}
                                {{ form_errors(missionForm.duration) }}
                            </div>
                        </div>
                    </section>

                    <section class="submission-step" data-step="1" hidden>
                        <div class="submission-step-heading">
                            <span>02</span>
                            <div><h3>À qui devons-nous répondre ?</h3><p>Un interlocuteur dédié vous recontactera sous 24 heures.</p></div>
                        </div>
                        <div class="form-grid">
                            <div class="field full">
                                {{ form_label(missionForm.company, 'Entreprise *') }}
                                {{ form_widget(missionForm.company, { attr: { placeholder: 'Votre organisation', autocomplete: 'organization', maxlength: 160 } }) }}
                                {{ form_errors(missionForm.company) }}
                            </div>
                            <div class="field full">
                                {{ form_label(missionForm.contactName, 'Nom et prénom *') }}
                                {{ form_widget(missionForm.contactName, { attr: { placeholder: 'Votre nom', autocomplete: 'name', maxlength: 160 } }) }}
                                {{ form_errors(missionForm.contactName) }}
                            </div>
                            <div class="field">
                                {{ form_label(missionForm.email, 'E-mail professionnel *') }}
                                {{ form_widget(missionForm.email, { attr: { placeholder: 'vous@entreprise.com', autocomplete: 'email', maxlength: 180 } }) }}
                                {{ form_errors(missionForm.email) }}
                            </div>
                            <div class="field">
                                {{ form_label(missionForm.phone, 'Téléphone') }}
                                {{ form_widget(missionForm.phone, { attr: { placeholder: '+352 …', autocomplete: 'tel', maxlength: 35 } }) }}
                                {{ form_errors(missionForm.phone) }}
                            </div>
                        </div>
                    </section>

                    <section class="submission-step" data-step="2" hidden>
                        <div class="submission-step-heading">
                            <span>03</span>
                            <div><h3>Contexte et objectifs</h3><p>Les éléments partagés restent confidentiels et nous permettent d’affiner la sélection.</p></div>
                        </div>
                        <div class="form-grid">
                            <div class="field full">
                                {{ form_label(missionForm.description, 'Décrivez votre besoin *') }}
                                {{ form_widget(missionForm.description, { attr: { rows: 7, placeholder: 'Contexte, enjeux, compétences attendues, livrables…', minlength: 20, maxlength: 4000 } }) }}
                                <small class="field-hint">20 caractères minimum</small>
                                {{ form_errors(missionForm.description) }}
                            </div>
                        </div>
                        <div class="consent">
                            {{ form_widget(missionForm.consent) }}
                            {{ form_label(missionForm.consent, 'J’accepte que mes informations soient utilisées pour traiter cette demande. *') }}
                            {{ form_errors(missionForm.consent) }}
                        </div>
                    </section>

                    {{ form_rest(missionForm) }}
                    <footer class="submission-modal-footer">
                        <button class="submission-back" type="button" data-role="previous" data-action="submission-modal#previous" hidden>
                            {{ ui.icon('arrow') }} Retour
                        </button>
                        <span class="submission-step-count" aria-live="polite">Étape 1 sur 3</span>
                        <button class="button button-primary" type="button" data-role="next" data-action="submission-modal#next">
                            Continuer <span class="arrow-box">{{ ui.icon('arrow') }}</span>
                        </button>
                        <button class="button button-primary" type="submit" data-role="submit" hidden>
                            Envoyer la mission <span class="arrow-box">{{ ui.icon('arrow') }}</span>
                        </button>
                    </footer>
                {{ form_end(missionForm, { render_rest: false }) }}
            </div>
        </div>
    </div>
</dialog>
