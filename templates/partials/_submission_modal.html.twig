{% import 'macros/ui.html.twig' as ui %}

<dialog class="submission-modal" data-submission-modal-target="dialog" data-action="click->submission-modal#backdrop close->submission-modal#closed" aria-labelledby="submission-modal-title">
    <div class="submission-modal-shell">
        <header class="submission-modal-header">
            <div>
                <div class="eyebrow">Your requirements</div>
                <h2 id="submission-modal-title">Submit your mission</h2>
                <p>A few details are all we need to start finding the right expert.</p>
            </div>
            <button class="submission-modal-close" type="button" data-action="submission-modal#close" aria-label="Close window">
                <span aria-hidden="true"></span>
            </button>
        </header>

        <div class="submission-modal-body">
            <div data-submission-modal-target="flow">
                {{ form_start(missionForm, { attr: { novalidate: 'novalidate', 'data-action': 'submit->submission-modal#validateSubmit' } }) }}
                    {{ form_errors(missionForm) }}
                    <div class="submission-progress" aria-label="Form progress">
                        <span class="is-active"><i>1</i><small>Mission</small></span>
                        <span><i>2</i><small>Contact</small></span>
                        <span><i>3</i><small>Context</small></span>
                    </div>

                    <section class="submission-step" data-step="0">
                        <div class="submission-step-heading">
                            <span>01</span>
                            <div><h3>Tell us about the assignment</h3><p>Describe your requirements so we can focus our search immediately.</p></div>
                        </div>
                        <div class="form-grid">
                            <div class="field full">
                                {{ form_label(missionForm.missionTitle, 'Assignment title *') }}
                                {{ form_widget(missionForm.missionTitle, { attr: { placeholder: 'e.g. Compliance Officer — AML/KYC support', autocomplete: 'off', maxlength: 160 } }) }}
                                {{ form_errors(missionForm.missionTitle) }}
                            </div>
                            <div class="field full">
                                {{ form_label(missionForm.expertise, 'Required expertise *') }}
                                {{ form_widget(missionForm.expertise) }}
                                {{ form_errors(missionForm.expertise) }}
                            </div>
                            <div class="field">
                                {{ form_label(missionForm.startDate, 'Preferred start date') }}
                                {{ form_widget(missionForm.startDate) }}
                                {{ form_errors(missionForm.startDate) }}
                            </div>
                            <div class="field">
                                {{ form_label(missionForm.duration, 'Estimated duration *') }}
                                {{ form_widget(missionForm.duration) }}
                                {{ form_errors(missionForm.duration) }}
                            </div>
                        </div>
                    </section>

                    <section class="submission-step" data-step="1" hidden>
                        <div class="submission-step-heading">
                            <span>02</span>
                            <div><h3>Who should we contact?</h3><p>A dedicated contact will get back to you within 24 hours.</p></div>
                        </div>
                        <div class="form-grid">
                            <div class="field full">
                                {{ form_label(missionForm.company, 'Company *') }}
                                {{ form_widget(missionForm.company, { attr: { placeholder: 'Your organisation', autocomplete: 'organization', maxlength: 160 } }) }}
                                {{ form_errors(missionForm.company) }}
                            </div>
                            <div class="field full">
                                {{ form_label(missionForm.contactName, 'Full name *') }}
                                {{ form_widget(missionForm.contactName, { attr: { placeholder: 'Your name', autocomplete: 'name', maxlength: 160 } }) }}
                                {{ form_errors(missionForm.contactName) }}
                            </div>
                            <div class="field">
                                {{ form_label(missionForm.email, 'Business email *') }}
                                {{ form_widget(missionForm.email, { attr: { placeholder: 'you@company.com', autocomplete: 'email', maxlength: 180 } }) }}
                                {{ form_errors(missionForm.email) }}
                            </div>
                            <div class="field">
                                {{ form_label(missionForm.phone, 'Phone') }}
                                {{ form_widget(missionForm.phone, { attr: { placeholder: '+352 …', autocomplete: 'tel', maxlength: 35 } }) }}
                                {{ form_errors(missionForm.phone) }}
                            </div>
                        </div>
                    </section>

                    <section class="submission-step" data-step="2" hidden>
                        <div class="submission-step-heading">
                            <span>03</span>
                            <div><h3>Context and objectives</h3><p>The information you share remains confidential and helps us refine our selection.</p></div>
                        </div>
                        <div class="form-grid">
                            <div class="field full">
                                {{ form_label(missionForm.description, 'Describe your requirements *') }}
                                {{ form_widget(missionForm.description, { attr: { rows: 7, placeholder: 'Context, priorities, required skills, deliverables…', minlength: 20, maxlength: 4000 } }) }}
                                <small class="field-hint">Minimum 20 characters</small>
                                {{ form_errors(missionForm.description) }}
                            </div>
                        </div>
                        <div class="consent">
                            {{ form_widget(missionForm.consent) }}
                            {{ form_label(missionForm.consent, 'I agree that my information may be used to process this request. *') }}
                            {{ form_errors(missionForm.consent) }}
                        </div>
                    </section>

                    {{ form_rest(missionForm) }}
                    <footer class="submission-modal-footer">
                        <button class="submission-back" type="button" data-role="previous" data-action="submission-modal#previous" hidden>
                            {{ ui.icon('arrow') }} Back
                        </button>
                        <span class="submission-step-count" aria-live="polite">Step 1 of 3</span>
                        <button class="button button-primary" type="button" data-role="next" data-action="submission-modal#next">
                            Continue <span class="arrow-box">{{ ui.icon('arrow') }}</span>
                        </button>
                        <button class="button button-primary" type="submit" data-role="submit" hidden>
                            Submit assignment <span class="arrow-box">{{ ui.icon('arrow') }}</span>
                        </button>
                    </footer>
                {{ form_end(missionForm, { render_rest: false }) }}
            </div>
        </div>
    </div>
</dialog>
